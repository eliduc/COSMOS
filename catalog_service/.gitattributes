# Схемы службы держатся в LF, как и схемы читателя
# (`template_catalog/.gitattributes`): копия схемы квитанции
# (`schemas/receipt.schema.json`) обязана оставаться БАЙТ-В-БАЙТ равной
# носителю у читателя при любой перематериализации git. Без этой строки
# клон на Windows получил бы носитель в LF (там правило есть), а копию в
# CRLF — и равенство рассыпалось бы на ровном месте, на машине, а не в
# коде.
schemas/*.json text eol=lf
