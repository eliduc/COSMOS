{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "cosmos-run-record/v1",
 "title": "Запись о прогоне (CDPM + COSMOS)",
 "description": "Словарь полей записи о прогоне одним носителем: голова (объявление, неизменна после старта), тело (журнал этапов, только дописывается), хвост (итоги). Схему читает модуль vmp/run_record.py, через него — CDPM, COSMOS и раннер наборов. Основание: final-report/PROEKT-ZAPIS-O-PROGONE-CLD.md, разделы 3 и 8.",
 "type": "object",
 "additionalProperties": false,
 "required": ["schema", "declaration", "declaration_sha256", "journal", "results"],
 "properties": {
  "schema": {
   "description": "Версия словаря полей.",
   "const": "cosmos-run-record/v1"
  },
  "declaration": {"$ref": "#/$defs/declaration"},
  "declaration_sha256": {
   "description": "Отпечаток объявления на момент создания записи: им судится неизменность головы после старта.",
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "journal": {
   "description": "Тело записи: этапы и подэтапы по мере хода. Только дописывается.",
   "type": "array",
   "items": {"$ref": "#/$defs/journal_entry"}
  },
  "results": {"$ref": "#/$defs/results"}
 },
 "$defs": {
  "sha256": {
   "type": ["string", "null"],
   "pattern": "^[0-9a-f]{64}$"
  },
  "moment": {
   "description": "Отметка времени ISO 8601. Пояс обязателен там, где отметку ставит сама запись; отметки, переписанные из носителей прежних версий (попытки COSMOS, журнал действий CDPM), пояса не несут и принимаются как есть.",
   "type": ["string", "null"],
   "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]+)?([+-][0-9]{2}:[0-9]{2}|Z)?$"
  },
  "moment_with_zone": {
   "description": "Отметка времени ISO 8601 обязательно с поясом: часы у прогона одни — часы площадки.",
   "type": "string",
   "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]+)?([+-][0-9]{2}:[0-9]{2}|Z)$"
  },
  "seconds": {
   "type": ["number", "null"],
   "minimum": 0
  },
  "count": {
   "type": ["integer", "null"],
   "minimum": 0
  },
  "words": {
   "description": "Слова человеку: деловой русский.",
   "type": ["string", "null"]
  },
  "reason_code": {
   "description": "Код причины исхода: машинное имя (kebab-case), рядом со словами.",
   "type": ["string", "null"]
  },

  "declaration": {
   "description": "Голова записи: параметры прогона до старта. После старта неизменна — служит рецептом повторения.",
   "type": "object",
   "additionalProperties": false,
   "required": ["run_id", "created_at", "created_by", "purpose", "contour",
                "airline", "rules_documents", "data_files", "answers",
                "catalog", "catalog_extension", "bindings", "models",
                "solvers", "code", "libraries", "planned_stages",
                "stop_after", "expectations", "lineage", "answer_policy"],
   "properties": {
    "run_id": {
     "description": "Номер прогона: один на обе системы.",
     "type": "string",
     "minLength": 1
    },
    "created_at": {"$ref": "#/$defs/moment_with_zone"},
    "created_by": {
     "description": "Кто объявил прогон: человек, служба или раннер.",
     "type": ["string", "null"]
    },
    "purpose": {
     "description": "Цель прогона.",
     "enum": ["приёмка", "демонстрация", "регресс", "исследование", "рабочий"]
    },
    "contour": {"$ref": "#/$defs/contour"},
    "airline": {"$ref": "#/$defs/airline"},
    "rules_documents": {
     "description": "Документы правил авиакомпании (ИДАК) с отпечатками.",
     "type": "array",
     "items": {"$ref": "#/$defs/rules_document"}
    },
    "data_files": {
     "description": "Книги операционных данных авиакомпании с отпечатками.",
     "type": "array",
     "items": {"$ref": "#/$defs/data_file"}
    },
    "answers": {
     "description": "Ревизии ответов на анкеты: тоже исходные документы — без них прогон не воспроизводится (раздел 7 проекта).",
     "type": "array",
     "items": {"$ref": "#/$defs/answer"}
    },
    "catalog": {"$ref": "#/$defs/catalog"},
    "catalog_extension": {
     "description": "Расширение каталога под конкретную авиакомпанию; расширения нет — null.",
     "oneOf": [{"$ref": "#/$defs/catalog_extension"}, {"type": "null"}]
    },
    "bindings": {"$ref": "#/$defs/bindings"},
    "models": {
     "description": "Модели по ролям: раскладка прогона обеих систем. Строка называет свою систему полем system; поля нет — модель CDPM.",
     "type": "array",
     "items": {"$ref": "#/$defs/model"}
    },
    "models_note": {
     "description": "Слова о неполноте раскладки: чьих моделей в голове нет и почему (пример: «COSMOS не опрошен при объявлении»). Не обязательно: раскладка полна — поля нет вовсе.",
     "type": ["string", "null"]
    },
    "solvers": {
     "description": "Решатели с параметрами: ветвь дерева прогонов задаётся ими наравне с моделями.",
     "type": "array",
     "items": {"$ref": "#/$defs/solver"}
    },
    "code": {"$ref": "#/$defs/code"},
    "libraries": {"$ref": "#/$defs/libraries"},
    "planned_stages": {
     "description": "План этапов: непройденные помечаются исходом «не начат», а не отсутствуют.",
     "type": "array",
     "items": {"type": "string"}
    },
    "stop_after": {
     "description": "Условие остановки: последний этап плана.",
     "type": ["string", "null"]
    },
    "expectations": {"$ref": "#/$defs/expectations"},
    "lineage": {"$ref": "#/$defs/lineage"},
    "answer_policy": {
     "description": "Кто отвечает на анкеты.",
     "enum": ["человек", "книга", null]
    }
   }
  },

  "contour": {
   "description": "Площадка прогона и адреса её служб.",
   "type": "object",
   "additionalProperties": false,
   "required": ["name", "services"],
   "properties": {
    "name": {"enum": ["local", "test", "stage", "prod"]},
    "services": {
     "description": "Адреса служб площадки по имени службы (панель, решатель, каталог). Учётные данные из адресов убираются.",
     "type": "object",
     "additionalProperties": {"type": ["string", "null"]}
    }
   }
  },

  "airline": {
   "description": "Авиакомпания прогона.",
   "type": "object",
   "additionalProperties": false,
   "required": ["name", "data_class", "llm_scope"],
   "properties": {
    "name": {"type": ["string", "null"]},
    "data_class": {"type": ["string", "null"]},
    "llm_scope": {"type": ["string", "null"]}
   }
  },

  "rules_document": {
   "type": "object",
   "additionalProperties": false,
   "required": ["name", "kind", "sha256", "size"],
   "properties": {
    "name": {"type": "string"},
    "kind": {
     "description": "Тип документа: docx, xlsx, pdf, jpg, txt и прочее.",
     "type": ["string", "null"]
    },
    "sha256": {"$ref": "#/$defs/sha256"},
    "size": {"$ref": "#/$defs/count"}
   }
  },

  "data_file": {
   "type": "object",
   "additionalProperties": false,
   "required": ["name", "sheets", "rows", "sha256"],
   "properties": {
    "name": {"type": "string"},
    "sheets": {"$ref": "#/$defs/count"},
    "rows": {"$ref": "#/$defs/count"},
    "sha256": {"$ref": "#/$defs/sha256"}
   }
  },

  "answer": {
   "type": "object",
   "additionalProperties": false,
   "required": ["revision", "sha256", "source", "at"],
   "properties": {
    "revision": {"type": ["string", "integer", "null"]},
    "sha256": {"$ref": "#/$defs/sha256"},
    "source": {"enum": ["человек", "книга набора", null]},
    "at": {"$ref": "#/$defs/moment"}
   }
  },

  "catalog": {
   "description": "Каталог шаблонов правил прогона. Ничего «из дерева по умолчанию»: каталог называется до старта.",
   "type": "object",
   "additionalProperties": false,
   "required": ["name", "version", "fingerprint", "path"],
   "properties": {
    "name": {"type": ["string", "null"]},
    "version": {"type": ["string", "null"]},
    "fingerprint": {"type": ["string", "null"]},
    "path": {"type": ["string", "null"]}
   }
  },

  "catalog_extension": {
   "type": "object",
   "additionalProperties": false,
   "required": ["name", "version", "fingerprint"],
   "properties": {
    "name": {"type": ["string", "null"]},
    "version": {"type": ["string", "null"]},
    "fingerprint": {"type": ["string", "null"]}
   }
  },

  "bindings": {
   "description": "Привязки исполнителей COSMOS: обязаны быть выпущены под каталог этого прогона.",
   "type": "object",
   "additionalProperties": false,
   "required": ["catalog_version", "catalog_fingerprint", "path"],
   "properties": {
    "catalog_version": {"type": ["string", "null"]},
    "catalog_fingerprint": {"type": ["string", "null"]},
    "path": {"type": ["string", "null"]}
   }
  },

  "model": {
   "type": "object",
   "additionalProperties": false,
   "required": ["role", "model", "provider", "channel", "effort"],
   "properties": {
    "role": {"type": "string"},
    "model": {"type": ["string", "null"]},
    "provider": {"type": ["string", "null"]},
    "channel": {"type": ["string", "null"]},
    "effort": {"type": ["string", "null"]},
    "system": {"description": "Система, чья это роль: cdpm (панель), runner (раннер наборов), cosmos (сертификатор, читатель ИДАК). Не обязательно: у записей до 11.09.2026 поля нет, и его отсутствие значит cdpm — голову чеканил хозяин записи, а моделей COSMOS в ней не было вовсе.",
               "type": ["string", "null"],
               "enum": ["cdpm", "runner", "cosmos", null]}
   }
  },

  "solver": {
   "description": "Решатель задачи с параметрами: имена — по носителям попытки COSMOS (раздел 3.2.3 проекта).",
   "type": "object",
   "additionalProperties": false,
   "required": ["task", "engine", "version", "build_sha256", "spent_limit_s",
                "unimproved_spent_limit_s", "moves", "seed", "step_limit",
                "unimproved_step_limit", "deterministic_time",
                "accepted_uncovered"],
   "properties": {
    "task": {
     "description": "Задача: пейринг или ростер.",
     "type": ["string", "null"]
    },
    "engine": {
     "description": "Движок: ortools / cplex / highs (пейринг), timefold (ростер).",
     "type": ["string", "null"]
    },
    "version": {"type": ["string", "null"]},
    "build_sha256": {"$ref": "#/$defs/sha256"},
    "spent_limit_s": {"$ref": "#/$defs/seconds"},
    "unimproved_spent_limit_s": {"$ref": "#/$defs/seconds"},
    "moves": {"type": ["string", "null"]},
    "seed": {"type": ["integer", "null"]},
    "step_limit": {"$ref": "#/$defs/count"},
    "unimproved_step_limit": {"$ref": "#/$defs/count"},
    "deterministic_time": {"$ref": "#/$defs/seconds"},
    "accepted_uncovered": {
     "description": "Непокрытые рейсы, принятые человеком.",
     "type": ["array", "null"],
     "items": {"type": "string"}
    }
   }
  },

  "code": {
   "description": "Код обеих систем и раннера на момент объявления.",
   "type": "object",
   "additionalProperties": false,
   "required": ["cdpm_commit", "cosmos_commit", "runner_fingerprint"],
   "properties": {
    "cdpm_commit": {"type": ["string", "null"]},
    "cosmos_commit": {"type": ["string", "null"]},
    "runner_fingerprint": {"type": ["string", "null"]}
   }
  },

  "libraries": {
   "description": "Интерпретатор и все пакеты установки: «все библиотеки» — слово владельца.",
   "type": "object",
   "additionalProperties": false,
   "required": ["python", "packages_sha256", "packages"],
   "properties": {
    "python": {"type": ["string", "null"]},
    "packages_sha256": {"$ref": "#/$defs/sha256"},
    "packages": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
       "name": {"type": "string"},
       "version": {"type": ["string", "null"]}
      }
     }
    }
   }
  },

  "expectations": {
   "description": "Чем судится прогон: манифест ожиданий набора либо прогон-образец.",
   "type": "object",
   "additionalProperties": false,
   "required": ["kind", "ref"],
   "properties": {
    "kind": {"type": ["string", "null"]},
    "ref": {"type": ["string", "null"]}
   }
  },

  "lineage": {
   "description": "Происхождение: корень дерева прогонов и родство. root_sha256 — корень по документам и данным (известен до старта); root_answers_sha256 — корень с ревизиями ответов (ставится, когда ответы закрыты); смена одного ответа даёт новую ветвь.",
   "type": "object",
   "additionalProperties": false,
   "required": ["root_sha256", "root_answers_sha256", "parent_run", "branch_of",
                "package_sha256", "source_run"],
   "properties": {
    "root_sha256": {"$ref": "#/$defs/sha256"},
    "root_answers_sha256": {"$ref": "#/$defs/sha256"},
    "parent_run": {"type": ["string", "null"]},
    "branch_of": {
     "description": "Чем ветвь отличается от родителя: модели / решатели / параметры / ответы.",
     "type": ["string", "null"]
    },
    "package_sha256": {"$ref": "#/$defs/sha256"},
    "source_run": {
     "description": "Прогон-источник входа, который этот прогон не производил (частичный прогон от готового ВМП).",
     "type": ["string", "null"]
    }
   }
  },

  "journal_entry": {
   "description": "Единица журнала: этап или подэтап с хронометражем, исходом, счётчиками и расходом ресурсов.",
   "type": "object",
   "additionalProperties": false,
   "required": ["stage", "substage", "started_at", "finished_at",
                "duration_machine_s", "duration_waiting_human_s", "outcome",
                "reason_code", "words", "actor", "artifacts", "counters",
                "resources"],
   "properties": {
    "stage": {"type": "string", "minLength": 1},
    "substage": {"type": ["string", "null"]},
    "started_at": {"$ref": "#/$defs/moment"},
    "finished_at": {"$ref": "#/$defs/moment"},
    "duration_machine_s": {"$ref": "#/$defs/seconds"},
    "duration_waiting_human_s": {"$ref": "#/$defs/seconds"},
    "outcome": {
     "enum": ["успех", "предупреждение", "отказ по правилу", "сбой",
              "остановлен человеком", "не начат"]
    },
    "reason_code": {"$ref": "#/$defs/reason_code"},
    "words": {"$ref": "#/$defs/words"},
    "actor": {
     "description": "Кто сделал: человек, служба, раннер.",
     "type": ["string", "null"]
    },
    "artifacts": {
     "type": "array",
     "items": {"$ref": "#/$defs/artifact"}
    },
    "counters": {
     "description": "Счётчики этапа: свободный словарь чисел. Имена — по носителям систем (раздел 3.2 проекта): files, clauses, rules, rounds, questions, chains, findings, uncovered.",
     "type": "object",
     "additionalProperties": {"type": ["number", "null"]}
    },
    "resources": {"$ref": "#/$defs/resources"},
    "system": {"description": "Система-летописец записи: cdpm (панель), runner (раннер наборов), cosmos; пусто — запись хозяина записи. Не обязательно: записи шага 1 и записи хозяина идут без поля.",
               "type": ["string", "null"],
               "enum": ["cdpm", "runner", "cosmos", null]}
   }
  },

  "artifact": {
   "description": "Артефакт этапа: ссылка и отпечаток, а не копия.",
   "type": "object",
   "additionalProperties": false,
   "required": ["kind", "path", "sha256"],
   "properties": {
    "kind": {"type": ["string", "null"]},
    "path": {"type": ["string", "null"]},
    "sha256": {"$ref": "#/$defs/sha256"}
   }
  },

  "resources": {
   "description": "Расход ресурсов этапа. Модели — в токенах по каждой модели (решение владельца № 1 от 10.09.2026): цена на момент прогона и на момент просмотра различаются, поэтому денег в записи нет.",
   "type": "object",
   "additionalProperties": false,
   "required": ["models", "solver_seconds"],
   "properties": {
    "models": {
     "type": "array",
     "items": {"$ref": "#/$defs/resource_model"}
    },
    "solver_seconds": {"$ref": "#/$defs/seconds"}
   }
  },

  "resource_model": {
   "type": "object",
   "additionalProperties": false,
   "required": ["role", "model", "provider", "calls", "input_tokens",
                "output_tokens", "counted", "note"],
   "properties": {
    "role": {"type": ["string", "null"]},
    "model": {"type": ["string", "null"]},
    "provider": {"type": ["string", "null"]},
    "calls": {"$ref": "#/$defs/count"},
    "input_tokens": {"$ref": "#/$defs/count"},
    "output_tokens": {"$ref": "#/$defs/count"},
    "counted": {
     "description": "Токены сосчитаны. Канал без usage (например CLI) даёт false и причину словами в note.",
     "type": "boolean"
    },
    "note": {"$ref": "#/$defs/words"}
   }
  },

  "results": {
   "description": "Хвост записи: вердикты, выдачи, сравнения, признак золотого прогона, хронометраж и состояние.",
   "type": "object",
   "additionalProperties": false,
   "required": ["verdicts", "deliveries", "comparison", "golden", "timing",
                "state"],
   "properties": {
    "verdicts": {
     "description": "Вердикты задач: свободный словарь «задача → вердикт».",
     "type": "object"
    },
    "deliveries": {
     "type": "array",
     "items": {"$ref": "#/$defs/artifact"}
    },
    "comparison": {"$ref": "#/$defs/comparison"},
    "golden": {"$ref": "#/$defs/golden"},
    "timing": {"$ref": "#/$defs/timing"},
    "state": {
     "enum": ["объявлен", "идёт", "завершён", "остановлен по правилу", "сбой",
              "остановлен человеком"]
    }
   }
  },

  "comparison": {
   "description": "Сравнения: с ожиданиями набора, с предыдущим прогоном той же авиакомпании и с золотым прогоном. Каждое — свободный словарь.",
   "type": "object",
   "additionalProperties": false,
   "required": ["expectations", "previous_run", "golden"],
   "properties": {
    "expectations": {"type": "object"},
    "previous_run": {"type": "object"},
    "golden": {"type": "object"}
   }
  },

  "golden": {
   "description": "Признак прогона-образца. Ставится ТОЛЬКО словом владельца после приёмки на Prod (решение владельца № 3 от 10.09.2026); умолчание — не подтверждён.",
   "type": "object",
   "additionalProperties": false,
   "required": ["confirmed", "by", "at", "words"],
   "properties": {
    "confirmed": {"type": "boolean"},
    "by": {"type": ["string", "null"]},
    "at": {"$ref": "#/$defs/moment"},
    "words": {"$ref": "#/$defs/words"}
   }
  },

  "timing": {
   "description": "Общий хронометраж прогона.",
   "type": "object",
   "additionalProperties": false,
   "required": ["machine_s", "waiting_human_s", "total_s"],
   "properties": {
    "machine_s": {"$ref": "#/$defs/seconds"},
    "waiting_human_s": {"$ref": "#/$defs/seconds"},
    "total_s": {"$ref": "#/$defs/seconds"}
   }
  }
 }
}
