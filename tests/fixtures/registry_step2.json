 "rule_mechanic_types": [
  [
   "calendar_windows",
   {
    "class": "extension",
    "executors": [
     "kotlin FlightCrewSchedulingConstraintProvider.calendarWindowLayovers",
     "kotlin TaskPackage.calendarWindowsOf"
    ],
    "title": "действия в окне дней недели (штраф ночёвок и родня); окно/пояс/действие — формой пакета, вес — весами пакета"
   }
  ],
  [
   "night_series",
   {
    "class": "core",
    "executors": [
     "kotlin LogicForms.consecutiveNightDuties (форма CONSECUTIVE_NIGHT_DUTIES_MAX; логика из посадки либо из блока logic; перенос series.consecutive_night_duties)",
     "kotlin LogicForms.nightDutiesInRollingWindow (форма NIGHT_DUTIES_IN_ROLLING_WINDOW_MAX; календарь history.calendar)",
     "python vmp/run/logic_checks._night_series / _night_window (сертификат: листы «Смены», «История», «Календарь истории»)"
    ],
    "title": "ночных смен подряд не более N (max_consecutive_night_duties) либо ночных смен в скользящем окне не более K (max_night_duties_in_window за night_window_days суток); ночная — начало смены в окне [night_duty_start, night_duty_end) местного времени базы; серия из истории продолжается первой ночной сменой горизонта, окна через границу горизонта — по посуточному календарю истории"
   }
  ],
  [
   "rolling_rest",
   {
    "class": "core",
    "executors": [
     "kotlin LogicForms.restInRollingWindow (форма REST_IN_ROLLING_WINDOW из блока logic; перенос last_duty.end)",
     "python vmp/run/logic_checks._rolling_rest (сертификат: листы «Назначения» и «История»)"
    ],
    "title": "в каждые N суток непрерывный отдых не менее W минут (скользящее окно weekly_rest_period, порог weekly_rest_required); окна открываются концом последней смены истории"
   }
  ],
  [
   "days_off_floor",
   {
    "class": "core",
    "executors": [
     "kotlin LogicForms.daysOffPerMonthMin (форма DAYS_OFF_PER_MONTH_MIN; логика из посадки либо из блока logic; перенос month_to_date.days_worked)",
     "kotlin LogicForms.daysOffInRollingWindow (форма DAYS_OFF_IN_ROLLING_WINDOW_MIN; календарь history.calendar)",
     "python vmp/run/logic_checks._days_off / _days_off_window (сертификат: листы «Назначения», «История», «Календарь истории»)"
    ],
    "title": "выходных в календарном месяце не менее N (min_days_off; месяц среза истории — с отработанными до среза сутками) либо выходных в скользящем окне не менее K (min_days_off_in_window за days_off_window_days суток; окна через границу горизонта — по посуточному календарю истории)"
   }
  ],
  [
   "layover_penalty",
   {
    "class": "core",
    "executors": [
