  {
   "sid": "S3",
   "line": "Смена — не более 11:30 (с согласия — до 13:00)."
  },
  {
   "sid": "S3",
   "line": "Стыковка вбазе — от 45 минут."
  },
  {
   "sid": "S3",
   "line": "Отдых дома — от 12 часов."
  },
  {
   "sid": "S3",
   "line": "Цепочка — не более 4 дней."
  },
  {
   "sid": "S3",
   "line": "Налёт за месяц — не более 90 часов."
  },
  {
   "sid": "S3",
   "line": "Выходных в месяце — не менее 8."
  },
  {
   "sid": "S3",
   "line": "Резерв: PLY — 3 экипажа, SVG и GRT — по 1."
  },
  {
   "sid": "S3",
   "line": "Экипаж — 2 пилота."
  },
  {
   "sid": "S3",
   "line": "После длинных цепочек — продолжительный отдых."
  }
 ]
